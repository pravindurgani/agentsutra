---
import BaseLayout from '../layouts/BaseLayout.astro';
import AgentThread from '../components/AgentThread.astro';
import { getVisibleFieldNotes } from '../lib/content';

const notes = await getVisibleFieldNotes();
const latest = notes.slice(0, 3);
const threadNodes = [
  {
    id: 'intent',
    label: 'Intent',
    kind: 'state' as const,
    description: 'Begin with a real question or task.',
  },
  {
    id: 'reason',
    label: 'Reason',
    kind: 'process' as const,
    description: 'Turn the problem into a mechanism you can inspect.',
  },
  {
    id: 'judge',
    label: 'Judge',
    kind: 'decision' as const,
    description: 'Test the claim against evidence and its boundary.',
  },
  {
    id: 'outcome',
    label: 'Outcome',
    kind: 'verified' as const,
    description: 'Leave with one action you can use.',
  },
];
---

<BaseLayout>
  <div class="home-field">
    <section class="home-hero" aria-labelledby="home-title" data-thread-stage="intent">
      <div class="home-hero__grid shell">
        <aside class="home-hero__status" aria-label="Publication status">
          <p>Private pilot</p>
          <strong>FIELD / 00</strong>
          <p>No public Field Notes yet. Three private pilots must pass before launch.</p>
        </aside>
        <div class="home-hero__copy">
          <h1 id="home-title">Follow the Thread.<br />Keep the boundary in view.</h1>
          <p class="home-hero__lead">
            AgentSutra is a public field laboratory for understanding AI systems. Each future Field
            Note will trace one reviewed experiment, failure or correction into a practical
            decision.
          </p>
          <nav class="home-hero__actions" aria-label="Start exploring">
            <a class="button button--primary" href="#experiment-fn-000">Inspect FN-000</a>
            <a class="text-link" href="/method/"
              >Read the publication method <span aria-hidden="true">→</span></a
            >
          </nav>
        </div>
        <div class="home-hero__thread" aria-hidden="true">
          <span class="home-hero__node home-hero__node--intent"></span>
          <span class="home-hero__node home-hero__node--decision"></span>
          <span class="home-hero__node home-hero__node--outcome"></span>
        </div>
      </div>
    </section>

    <section
      class="page-section thread-map"
      id="thread-map"
      aria-labelledby="thread-map-title"
      data-thread-stage="reason"
    >
      <div class="thread-map__grid shell">
        <header class="thread-map__intro">
          <h2 id="thread-map-title">The Thread Map</h2>
          <p>
            One fixed grammar keeps intent, reasoning, judgement and outcome connected. Shape and
            labels carry the meaning; colour only reinforces it.
          </p>
        </header>
        <div class="thread-map__diagram">
          <AgentThread title="How a Field Note earns an outcome" nodes={threadNodes} />
        </div>
      </div>
    </section>

    <section
      class="page-section specimen-section"
      id="experiment-fn-000"
      aria-labelledby="specimen-title"
      data-thread-stage="judge"
    >
      <article class="specimen shell">
        <header class="specimen__header">
          <p class="specimen__folio">Experiment / FN-000</p>
          <div class="specimen__stamps" aria-label="Evidence status">
            <span>Synthetic specimen</span>
            <span class="evidence-stamp evidence-stamp--bounded">BOUNDED</span>
          </div>
          <h2 id="specimen-title">Stress the publishing contract before trusting the pipeline.</h2>
          <p>
            FN-000 is deliberately fictional. It exercises schemas, long copy, cross-record links
            and evidence boundaries; it makes no claim about a real AI system or production result.
          </p>
        </header>
        <dl class="specimen__ledger">
          <div>
            <dt>Question</dt><dd>
              Can one synthetic record pressure-test the complete publication graph?
            </dd>
          </div>
          <div>
            <dt>What ran</dt><dd>
              Strict schema parsing, reference matching and fixture-only route exclusion.
            </dd>
          </div>
          <div>
            <dt>What passed</dt><dd>
              The declared synthetic data contracts in the explicit fixture build.
            </dd>
          </div>
          <div>
            <dt>Boundary</dt><dd>
              No audience comprehension, real-world accuracy, security or public-release claim.
            </dd>
          </div>
          <div>
            <dt>Transfer</dt><dd>
              Repeat the validation graph with real, reviewed evidence before publishing a Field
              Note.
            </dd>
          </div>
        </dl>
        <p class="specimen__action">
          <a class="text-link" href="/method/"
            >See the evidence and correction method <span aria-hidden="true">→</span></a
          >
        </p>
      </article>
    </section>

    <section
      class="page-section publication-status"
      aria-labelledby="field-notes-title"
      data-thread-stage="boundary"
    >
      <div class="publication-status__grid shell">
        <header>
          <h2 id="field-notes-title">Field Notes</h2>
          <p>
            Canonical lessons will appear here only after their evidence and privacy gates pass.
          </p>
        </header>
        {
          latest.length > 0 ? (
            <div class="note-ledger">
              {latest.map((note) => (
                <article class="note-record">
                  <p class="note-record__folio">{note.id}</p>
                  <h3>
                    <a href={`/field-notes/${note.slug}/`}>{note.title}</a>
                  </h3>
                  <p class="note-record__answer">{note.answer}</p>
                  <p class="note-record__meta">
                    {note.arc} / {note.difficulty}
                  </p>
                </article>
              ))}
            </div>
          ) : (
            <div class="pilot-empty">
              <strong>0 published</strong>
              <p>The first evidence-reviewed Field Notes are in private pilot production.</p>
            </div>
          )
        }
        <p class="publication-status__action">
          <a class="text-link" href="/field-notes/"
            >Open the Field Note register <span aria-hidden="true">→</span></a
          >
        </p>
      </div>
    </section>

    <section class="home-sutra" aria-labelledby="home-sutra-title" data-thread-stage="outcome">
      <div class="home-sutra__grid shell">
        <p>The Sutra</p>
        <blockquote id="home-sutra-title">A useful claim carries its limit with it.</blockquote>
        <a class="text-link" href="/start-here/"
          >Choose a way into the field <span aria-hidden="true">→</span></a
        >
      </div>
    </section>
  </div>
</BaseLayout>
