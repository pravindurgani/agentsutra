---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getVisibleFieldNotes } from '../lib/content';

const notes = await getVisibleFieldNotes();
const arcs = new Map<string, typeof notes>();
for (const note of notes) {
  const bucket = arcs.get(note.arc) ?? [];
  bucket.push(note);
  arcs.set(note.arc, bucket);
}
---

<BaseLayout
  title="Start here — AgentSutra"
  description="Choose an AgentSutra learning path and begin with an independently useful, evidence-bounded AI Field Note."
  canonicalPath="/start-here/"
>
  <header class="page-intro">
    <div class="page-intro__grid shell">
      <p class="page-intro__context">Learning map</p>
      <div>
        <h1>Choose what you need. Stop when you have it.</h1>
        <p class="page-intro__lead">
          Every Field Note has a complete practical route and an open technical record. You do not
          need to read the whole archive—or understand an agent system—to use one lesson.
        </p>
      </div>
    </div>
  </header>
  <section class="page-section">
    <div class="section-grid shell">
      <h2>Three depths, one lesson</h2>
      <dl class="reader-paths">
        <div>
          <dt>Use it</dt><dd>
            Read the situation, explanation, limit and action. That is a complete lesson.
          </dd>
        </div>
        <div>
          <dt>Understand it</dt><dd>
            Add the visual Thread and the plain-language evidence summary.
          </dd>
        </div>
        <div>
          <dt>Audit it</dt><dd>Inspect conditions, sources, versions and corrections.</dd>
        </div>
      </dl>
    </div>
  </section>
  <section class="page-section">
    <div class="section-grid shell">
      <h2>Learning map</h2>
      {
        arcs.size > 0 ? (
          <div class="route-ledger">
            {[...arcs.entries()].map(([arc, entries]) => (
              <section class="route-record">
                <h3>{arc}</h3>
                <p>
                  {entries.length} {entries.length === 1 ? 'Field Note' : 'Field Notes'}
                </p>
                <ol class="step-list">
                  {entries.map((entry) => (
                    <li>
                      <a href={`/field-notes/${entry.slug}/`}>{entry.title}</a>
                    </li>
                  ))}
                </ol>
              </section>
            ))}
          </div>
        ) : (
          <div class="pilot-empty" data-empty-state="start-here">
            <strong>No public lessons yet</strong>
            <p>
              Three pilot lessons must be completed and reader-tested before launch. This page
              becomes the learning map after the first reviewed release.
            </p>
            <a href="/method/">See how a lesson is reviewed</a>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
